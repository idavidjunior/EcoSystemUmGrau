<html>
<head>
<title>RAM Widget</title>
<hta:application 
    id="oHTA"
    border="none"
    caption="no"
    showintaskbar="no"
    singleinstance="yes"
    sysmenu="no"
    maximibox="no"
    minimizebutton="no"
    selection="no"
    contextmenu="no"
    innerborder="no"
    transparent="yes"
    showintaskbar="no"
/>
<style>
    body { 
        background-color: transparent; 
        color: white; 
        font-family: Segoe UI; 
        margin: 0px; 
        padding: 10px;
    }
    .title { font-weight: bold; font-size: 14px; }
    .value { font-size: 16px; margin-top: 5px; }
    .bar { 
        background-color: #555; 
        height: 6px; 
        margin-top: 5px; 
        border-radius: 3px; 
        overflow: hidden;
    }
    .bar-fill { 
        background-color: #0078D7; 
        height: 100%; 
        width: 0%; 
        transition: width 0.5s;
    }
</style>
</head>
<body>
    <div class="title">MEMÓRIA RAM</div>
    <div id="info" class="value">Carregando...</div>
    <div class="bar"><div id="fill" class="bar-fill"></div></div>

<script language="JavaScript">
    var memInfo = document.getElementById("info");
    var barFill = document.getElementById("fill");

    // Make window stay on top
    window.topmost = true;

    function updateRAM() {
        try {
            var locator = new ActiveXObject("WbemScripting.SWbemLocator");
            var service = locator.ConnectServer(".", "root\\cimv2");
            var mem = service.ExecQuery("Select * From Win32_OperatingSystem");
            var e = new Enumerator(mem);
            var os = e.item();
            var totalVisible = os.TotalVisibleMemorySize; // in KB
            var freePhysical = os.FreePhysicalMemory; // in KB
            var used = totalVisible - freePhysical;
            var percent = (used / totalVisible) * 100;
            var totalGB = totalVisible / 1024 / 1024;
            var usedGB = used / 1024 / 1024;
            memInfo.innerHTML = percent.toFixed(1) + "% (" + usedGB.toFixed(1) + " GB / " + totalGB.toFixed(1) + " GB)";
            barFill.style.width = percent + "%";
        } catch(e) {
            memInfo.innerHTML = "Erro";
        }
    }

    // Update immediately then every second
    updateRAM();
    setInterval(updateRAM, 1000);
</script>
</body>
</html>