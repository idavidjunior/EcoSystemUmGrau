<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="#1E1E1E">

        <TextView
            android:id="@+id/btn_close_eq"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Equalizador"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btn_eq_toggle"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="EQ ON"
            android:background="@drawable/bg_preset_active"
            android:textColor="#00BFFF"
            android:textSize="8sp"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_recarregar"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="CARREGAR"
            android:background="@drawable/bg_preset_btn"
            android:textColor="#B0B0B0"
            android:textSize="7sp"
            android:paddingHorizontal="6dp"
            android:layout_marginEnd="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_save_eq"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="SALVAR"
            android:background="@drawable/bg_preset_active"
            android:textColor="#00BFFF"
            android:textSize="7sp"
            android:paddingHorizontal="6dp"
            android:layout_marginEnd="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_reset_eq"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="REINICIAR"
            android:background="@drawable/bg_preset_btn"
            android:textColor="#B0B0B0"
            android:textSize="7sp"
            android:paddingHorizontal="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3D3D3D" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/bands_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3D3D3D"
            android:layout_gravity="bottom" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1E1E1E">

        <TextView
            android:id="@+id/btn_prev_preset"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="\u25C0"
            android:textColor="#00BFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/knob_presets_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_preset_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Predefini\u00e7\u00f5es"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="toque para lista"
                android:textColor="#B0B0B0"
                android:textSize="7sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_next_preset"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="\u25B6"
            android:textColor="#00BFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="#3D3D3D" />

        <LinearLayout
            android:id="@+id/knob_volume_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_limiter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIM: 0.0 dB"
                android:textColor="#66BB6A"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Volume"
                android:textColor="#B0B0B0"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
