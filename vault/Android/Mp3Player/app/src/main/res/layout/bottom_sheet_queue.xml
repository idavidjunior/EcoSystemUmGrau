<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fila de Reprodu\u00e7\u00e3o"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_queue_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nenhuma musica na fila"
        android:textColor="#888888"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#3D3D3D"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btn_clear_queue"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="LIMPAR FILA"
        android:background="@drawable/bg_preset_btn"
        android:textColor="#FF4444"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
