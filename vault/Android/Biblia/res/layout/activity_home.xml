<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?android:attr/actionBarSize"
        android:background="@color/primary"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:gravity="center" />

    </Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/padding_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/lastReadingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:elevation="3dp"
                android:layout_marginBottom="16dp"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/last_reading"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/lastReadingRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/lastReadingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.4" />

                    <Button
                        android:id="@+id/btnContinueReading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/continue_reading"
                        android:background="@drawable/btn_primary"
                        android:textColor="@android:color/white"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textAllCaps="false" />

                </LinearLayout>

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent"
                    android:layout_gravity="left" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/verseOfDayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:elevation="3dp"
                android:layout_marginBottom="16dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verse_of_day"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/verseOfDayText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="italic"
                        android:lineSpacingMultiplier="1.5"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/verseOfDayRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

            <FrameLayout
                android:id="@+id/readingPlanProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:elevation="3dp"
                android:layout_marginBottom="16dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reading_progress"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <ProgressBar
                        android:id="@+id/readingProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:progressTint="@color/accent"
                        android:progressBackgroundTint="@color/surface_variant" />

                    <TextView
                        android:id="@+id/readingProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </FrameLayout>

            <Button
                android:id="@+id/btnStartReading"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/start_reading"
                android:textSize="16sp"
                android:background="@drawable/btn_primary"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:layout_marginTop="4dp" />

            <FrameLayout
                android:id="@+id/resourcesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:elevation="3dp"
                android:layout_marginTop="16dp"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/resourcesHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/my_resources"
                            android:textSize="14sp"
                            android:textColor="@color/accent"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:clickable="true"
                            android:background="?android:attr/selectableItemBackground" />

                        <TextView
                            android:id="@+id/btnOpenResources"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:text="Ver tudo ▸"
                            android:textColor="@color/accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:background="@drawable/nav_item_bg" />

                        <TextView
                            android:id="@+id/btnImportFile"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:text="+ Arquivo"
                            android:textColor="@color/accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:background="@drawable/nav_item_bg" />

                        <TextView
                            android:id="@+id/btnImportFolder"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:text="+ Pasta"
                            android:textColor="@color/accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:background="@drawable/nav_item_bg" />

                    </LinearLayout>

                    <ListView
                        android:id="@+id/resourceList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:divider="@null"
                        android:dividerHeight="0dp" />

                    <TextView
                        android:id="@+id/emptyResources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nenhum recurso importado. Toque em + Arquivo ou + Pasta para adicionar."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:padding="16dp"
                        android:gravity="center" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_navigation" />

</LinearLayout>
