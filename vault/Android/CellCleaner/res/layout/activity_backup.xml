<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@null"
            android:tint="@color/text_on_primary"
            android:onClick="closeBackup" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Backup de APKs"
            android:textColor="@color/text_on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
        <View android:layout_width="40dp" android:layout_height="1dp" />
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/backupStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carregando apps…"
        style="@style/TextBody"
        android:textColor="@color/text_secondary"
        android:padding="12dp" />

    <!-- Summary -->
    <TextView
        android:id="@+id/backupSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 selecionados"
        style="@style/TextBody"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp" />

    <!-- Progress -->
    <LinearLayout
        android:id="@+id/backupProgressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/backupProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:max="100" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extraindo APKs…"
            style="@style/TextBody"
            android:textColor="@color/text_secondary"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btnBackupSelectAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:text="Selecionar Todos"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_marginRight="6dp" />
        <Button
            android:id="@+id/btnBackupSelected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="Fazer Backup"
            android:textSize="13sp"
            android:textColor="@color/text_on_primary"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- App List -->
    <ListView
        android:id="@+id/backupAppList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1px" />
</LinearLayout>