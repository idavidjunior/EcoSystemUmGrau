<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:id="@+id/categoryIconContainer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:background="@drawable/bg_category_icon"
        android:layout_marginRight="12dp">

        <ImageView
            android:id="@+id/categoryIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_cache" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/categoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cache"
            style="@style/TextTitle"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/categoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 itens"
            style="@style/TextSubtitle"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/categorySize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="128 MB"
        style="@style/TextBody"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginRight="8dp" />

    <ImageView
        android:id="@+id/categoryArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        android:tint="@color/tab_inactive"
        android:visibility="gone" />
</LinearLayout>
