    "limpeza": {
      "descricao": "Técnicas e comandos para limpeza do dispositivo",
      "limpeza_cache": [
        "adb shell pm clear <package>",
        "adb shell rm -rf /data/cache/*",
        "adb shell rm -rf /sdcard/Android/data/<package>/cache/*",
        "adb shell rm -rf /data/system/package_cache/*"
      ],
      "limpeza_dados": [
        "adb shell pm clear <package>",
        "adb shell rm -rf /sdcard/DCIM/.thumbnails/*",
        "adb shell rm -rf /sdcard/Pictures/.thumbnails/*",
        "adb shell rm -rf /sdcard/Download/*.apk",
        "adb shell rm -rf /sdcard/*.tmp"
      ],
      "limpeza_logs": [
        "adb shell rm -rf /data/log/*",
        "adb shell rm -rf /sdcard/Android/log/*",
        "adb logcat -c"
      ],
      "limpeza_avancada": [
        "adb shell pm uninstall -k --user 0 <package>",
        "adb shell pm disable-user --user 0 <package>",
        "adb shell settings put global hidden_api_policy 1"
      ]
    },

