{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{LLM_MODEL}}",
  "plugin": [
    "@razroo/opencode-model-fallback"
  ],
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      }
    }
  },
  "mcp": {
    "eco-knowledge": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/scripts/mcp-knowledge-server.py"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/filesystem/index.js"],
      "enabled": true
    },
    "search": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/search/index.js"],
      "enabled": true
    },
    "terminal": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/terminal/index.js"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/github/index.js"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GH_TOKEN}"
      }
    },
    "eco-obsidian": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/scripts/mcp-obsidian-server.py"],
      "enabled": true
    },
    "mcp-desenvolvimento": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/desenvolvimento/server.py"],
      "enabled": true
    },
    "mcp-android": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/android/server.py"],
      "enabled": true
    },
    "mcp-internet": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/internet/server.py"],
      "enabled": true
    },
    "mcp-memoria": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/memoria/server.py"],
      "enabled": true
    },
    "mcp-multimidia": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/multimidia/server.py"],
      "enabled": true
    },
    "mcp-comportamentais": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/comportamentais/server.py"],
      "enabled": true
    },
    "mcp-compreensao-pedidos": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/nucleo/habilidades/compreensao-pedidos/server.py"],
      "enabled": true
    }
  },
  "command": {
    "ouvir": {
      "description": "Ouvir: captura sua voz (STT) e usa como prompt",
      "template": "O usuario falou via microfone. Segue a transcricao:\n\n!`python scripts/vox_audio.py ouvir`\n\nAgora execute o que foi pedido na fala."
    },
    "falar": {
      "description": "Falar: abre o modo de voz (TTS)",
      "template": "Fale em voz alta o seguinte texto usando TTS. Execute o script vox_audio.py no modo falar com este texto como argumento:\n\n$ARGUMENTS\n\nResposta curta apos falar."
    },
    "dialogo": {
      "description": "Dialogo por voz: inicia o modo conversa (fala, ele ouve/responde/executa)",
      "template": "O usuario quer iniciar o modo dialogo por voz no PC. Execute em background (nao bloqueie esta sessao):\n\n!`python scripts/dialogo.py --modo $ARGUMENTS`\n\nModos validos: vad (maos-livres), push (segure espaco), ativacao (diga Jarvis). Se $ARGUMENTS estiver vazio, use vad. Explique como voltar (Ctrl+C)."
    },
    "compreender": {
      "description": "Compreender pedido: analisa o que o usuario quer (objetivo, acoes, conceitos, restricoes, ambiguidades, desperdicio) antes de executar",
      "agent": "compreender",
      "template": "Compreenda o pedido a seguir seguindo o protocolo do agente compreender (responda sempre em pt-BR). Use o MCP mcp-compreensao-pedidos:\n\n1. Execute `compreender_pedido` com o pedido: \"$ARGUMENTS\"\n2. Se score < 60 ou julgamento AMBIGUO, esclareca com o usuario citando as ambiguidades antes de agir\n3. Se `detectar_desperdicio` apontar repeticao ou escopo creep, combine antes de ampliar\n4. Use `criterios_sucesso` e `plano_sugerido` como contrato da execucao\n\nPedido a compreender: \"$ARGUMENTS\""
    },
    "eco": {
      "description": "Ativar/verificar EcoSystemUmGrau: saudação breve ou relatório completo (/eco relatorio)",
      "agent": "eco",
      "template": "Ative ou verifique o EcoSystemUmGrau seguindo o protocolo do agente eco (responda sempre em pt-BR).\n\n1. Verifique a integridade (silencioso): `python scripts/runtime_boot.py --check`\n2. Se INTEGRIDADE: OK -> responda com saudação ESPONTÂNEA e CURTA (máx 3-4 linhas), variando o tom cada vez. Nunca repita a mesma frase. Inclua leve contexto (projeto ativo, memória, pendências).\n3. Se houver problema -> reporte brevemente o que deu errado e o que foi corrigido.\n4. Se o argumento for 'relatorio' ou o usuário pedir detalhes -> faça o relatório COMPLETO (integridade, estado, model monitor, correções).\n5. Abrir widget: `start \"\" pythonw scripts/widget_controle_jarvis.py`\n\nComando recebido: $ARGUMENTS"
    },
    "sync": {
      "description": "Sincronizar EcoSystemUmGrau: Local PC + GitHub, 3 camadas, MCPs, secrets, memória e runtime. Corrige e commite automaticamente.",
      "agent": "sync",
      "template": "Execute o protocolo de sincronização @sync completo seguindo o agente sync (responda sempre em pt-BR). Etapas obrigatórias a partir da raiz do EcoSystemUmGrau:\n\n1. `python scripts/runtime_boot.py` — bootloader e integridade\n2. `python scripts/sync_rules.py audit` — verifica e corrige 3 camadas (Constituição ↔ AGENTS.md ↔ Deployed)\n3. Deploy config: sincroniza config/opencode.jsonc para ~/.config/opencode/ (com backup .bak)\n4. `python scripts/preflight_check.py` — valida MCPs, secrets, agents\n5. `python scripts/preflight_etica.py` — valida deveres externos, privacidade, acessibilidade\n6. `git status --short` via gate scripts/persistencia.ps1 status\n7. `scripts/persistencia.ps1 sync` — git pull + push (nunca git direto)\n8. `python scripts/memory_engine.py stats` — integridade da memória\n9. `python scripts/runtime_state.py checkpoint \"@sync\"` — salva checkpoint\n\nSe tudo OK: reporte relatório objetivo. Se detectar inconsistências: corrija, notifique, revalide e commite via gate.\n\nComando: $ARGUMENTS"
    },
    "controle": {
      "description": "Controle: abre janela flutuante visual do Jarvis (voz ON/OFF, parar fala, microfone ON/OFF)",
      "template": "!`\"scripts/controle.bat\"` (abre janela flutuante de controle da voz: voz ON/OFF, parar fala, microfone)"
    },
    "ecocell": {
      "description": "EcoCell: abre espelho de tela do celular via scrcpy",
      "agent": "ecocell",
      "template": "Abra o espelho de tela do celular via scrcpy seguindo o protocolo do agente ecocell (responda sempre em pt-BR).\n\n1. Execute em background: `Start-Process python -ArgumentList \"\\\"scripts/scrcpy/scrcpy_daemon.py\\\"\",\"--once\" -WindowStyle Hidden`\n2. Aguarde 3 segundos e verifique o log: `Start-Sleep 3; Get-Content \"$env:TEMP\\scrcpy_daemon.log\" -Tail 3`\n3. Se o log mostrar 'Device alvo' sem erro subsequente, confirme: 'EcoCell aberto. Tela do celular espelhada.'\n4. Se houver erro, reporte o problema.\n\nComando recebido: $ARGUMENTS"
    },
    "ecomodelo": {
      "description": "Gerenciamento inteligente de modelos: monitora performance, limites e troca automática. Use /ecomodelo status, /ecomodelo on, /ecomodelo off, /ecomodelo trocar <modelo>, /ecomodelo config",
      "agent": "ecomodelo",
      "template": "Execute o Model Monitor do EcoSystemUmGrau seguindo o protocolo do agente ecomodelo (responda sempre em pt-BR).\n\n1. Analise o argumento: \"$ARGUMENTS\"\n2. Se vazio ou 'status': execute `python scripts/model_monitor.py status`\n3. Se 'on': execute `python scripts/model_monitor.py on`\n4. Se 'off': execute `python scripts/model_monitor.py off`\n5. Se 'trocar <modelo>': execute `python scripts/model_monitor.py trocar <modelo>`\n6. Se 'config': execute `python scripts/model_monitor.py config`\n7. Se 'config --limite-custo <valor>': execute com o argumento\n8. Se 'rankings': execute `python scripts/model_monitor.py rankings`\n9. Se 'registrar <modelo> <latencia_ms> <sucesso>': execute com os argumentos\n10. Se 'reset': execute `python scripts/model_monitor.py reset`\n11. Reporte o resultado de forma clara e objetiva.\n\nComando: $ARGUMENTS"
    },
    "reiniciarjarvis": {
      "description": "Reinicia narrador, widget e bridge do Jarvis: mata processos, para TTS ativo, reinicia narrador e widget sem console",
      "template": "!`\"scripts/reiniciarjarvis.bat\"`"
    },
    "perfil": {
      "description": "Perfil adaptativo do usuário: stats, config, correções (ex: /perfil stats, /perfil config, /perfil correct no_markdown)",
      "template": "!`python scripts/user_profile.py $ARGUMENTS`"
    },
    "bootstrap": {
      "description": "Bootstrap completo do agente: carrega runtime, contexto, perfil do usuário",
      "template": "!`python scripts/agent_bootstrap.py bootstrap $ARGUMENTS`"
    }
  },
  "agent": {
    "compreensao-refino": {
      "description": "Refinador de compreensao de pedidos — responde apenas em texto, sem ferramentas (usado pelo mcp-compreensao-pedidos como LLM primaria do refino)",
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "*": "deny"
      },
      "prompt": "Voce e o refinador do modulo de Compreensao de Pedidos do EcoSystemUmGrau. Recebe um pedido e um entendimento heuristico. Responda APENAS com um unico objeto JSON valido, sem markdown e sem texto antes ou depois: {\"objetivo_corrigido\": string, \"lacunas\": [strings], \"melhorias\": [strings], \"observacao\": string}. Nao use ferramentas. Nao mencione boot, runtime, memoria ou processos internos."
    }
  },
  "permission": "allow",
  "instructions": [
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/AGENTS.md",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/config/agents/00-system-rules.md",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/ler-runtime",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/**/habilidades/**/SKILL.md",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/**/habilidades/**/skill.md",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp/internet/habilidades/clima-api/skill.md"
  ]
}
