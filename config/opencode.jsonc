{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/plugins/ponytail/.opencode/plugins/ponytail.mjs",
    "@razroo/opencode-model-fallback"
  ],
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      }
    }
  },
  "mcp": {
    "eco-knowledge": {
      "type": "local",
      "command": ["python", "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/scripts/mcp-knowledge-server.py"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["node", "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/mcp-servers/mcp-servers/filesystem/index.js"],
      "enabled": true
    },
    "search": {
      "type": "local",
      "command": ["node", "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/mcp-servers/mcp-servers/search/index.js"],
      "enabled": true
    },
    "terminal": {
      "type": "local",
      "command": ["node", "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/mcp-servers/mcp-servers/terminal/index.js"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["node", "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/mcp-servers/mcp-servers/github/index.js"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GH_TOKEN}"
      }
    }
  },
  "instructions": [
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/*/SKILL.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/**/SKILL.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/*/skill.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/**/skill.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/clima-api/skill.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/ler-runtime/CONHECIMENTO.md"
  ]
}
