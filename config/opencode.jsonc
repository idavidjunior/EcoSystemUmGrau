{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    {
      "name": "@razroo/opencode-model-fallback",
      "config": {
        "enabled": true,
        "retry_on_errors": [429, 500, 502, 503, 504],
        "retryable_error_patterns": ["rate limit", "quota exceeded", "insufficient quota", "too many requests", "capacity exceeded"],
        "max_fallback_attempts": 5,
        "cooldown_seconds": 2,
        "timeout_seconds": 15,
        "notify_on_fallback": true,
        "fallback_models": [
          "opencode/nemotron-3-ultra-free",
          "opencode/deepseek-v4-flash-free",
          "opencode/laguna-s-2.1-free",
          "opencode/ling-3.0-flash-free",
          "opencode/mimo-v2.5-free",
          "opencode/north-mini-code-free",
          "opencode/big-pickle"
        ]
      }
    }
  ],
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      }
    }
  },
  "mcp": {
    "eco-knowledge": {
      "type": "local",
      "command": ["python", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/scripts/mcp-knowledge-server.py"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/mcp-servers/filesystem/index.js"],
      "enabled": true
    },
    "search": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/mcp-servers/search/index.js"],
      "enabled": true
    },
    "terminal": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/mcp-servers/terminal/index.js"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["node", "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/mcp-servers/mcp-servers/github/index.js"],
      "enabled": false,
      "environment": {
        "GITHUB_TOKEN": "{env:GH_TOKEN}"
      }
    }
  },
  "command": {
    "ouvir": {
      "description": "Ouvir: captura sua voz (STT) e usa como prompt",
      "template": "O usuario falou via microfone. Segue a transcricao:\n\n!`python \"C:/Users/David Jr/Documents/Default Project/EcoSystemUmGrau/scripts/vox_audio.py\" ouvir`\n\nAgora execute o que foi pedido na fala."
    },
    "falar": {
      "description": "Falar: abre o modo de voz (TTS)",
      "template": "Fale em voz alta o seguinte texto usando TTS. Execute o script vox_audio.py no modo falar com este texto como argumento:\n\n$ARGUMENTS\n\nResposta curta apos falar."
    },
    "dialogo": {
      "description": "Dialogo por voz: inicia o modo conversa (fala, ele ouve/responde/executa)",
      "template": "O usuario quer iniciar o modo dialogo por voz no PC. Execute em background (nao bloqueie esta sessao):\n\n!`python \"C:/Users/David Jr/Documents/Default Project/EcoSystemUmGrau/scripts/dialogo.py\" --modo $ARGUMENTS`\n\nModos validos: vad (maos-livres), push (segure espaco), ativacao (diga Jarvis). Se $ARGUMENTS estiver vazio, use vad. Explique como voltar (Ctrl+C)."
    }
  },
  "permission": "allow",
  "instructions": [
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/Habilidades/**/SKILL.md",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/Habilidades/**/skill.md",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/Habilidades/tecnicas/clima-api/skill.md",
    "{{USERPROFILE}}/Documents/Default Project/EcoSystemUmGrau/ler-runtime/CONHECIMENTO.md"
  ]
}
