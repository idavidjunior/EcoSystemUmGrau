{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/plugins/ponytail/.opencode/plugins/ponytail.mjs",
    "@razroo/opencode-model-fallback"
  ],
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      }
    }
  },
  "mcp": {
    "servers": {
      "eco-knowledge": {
        "command": "python",
        "args": [
          "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/scripts/mcp-knowledge-server.py"
        ]
      }
    }
  },
  "instructions": [
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/*/SKILL.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/**/SKILL.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/*/skill.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/skills/**/skill.md",
    "C:/Users/Playtec-bancada/Desktop/Codigos/EcoSystemUmGrau/ler-runtime/CONHECIMENTO.md"
  ]
}
